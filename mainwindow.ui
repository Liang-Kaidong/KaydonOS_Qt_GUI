    <widget class="QSlider" name="voiceControlSlider">
     <property name="geometry">
      <rect>
       <x>906</x>
       <y>0</y>
       <width>100</width>
       <height>80</height>
      </rect>
     </property>
     <property name="minimumSize">
      <size>
       <width>100</width>
       <height>36</height>
      </size>
     </property>
     <property name="maximumSize">
      <size>
       <width>100</width>
       <height>80</height>
      </size>
     </property>
     <property name="focusPolicy">
      <enum>Qt::NoFocus</enum>
     </property>
     <property name="styleSheet">
      <string notr="true">/* 1. 整个 Slider：可点击区域 */
QSlider {
    min-height: 36px;
    background: transparent;
}

/* 2. 凹槽 */
QSlider::groove:horizontal {
    height: 30px;
    border-radius: 5px;
    background-color: rgba(255, 255, 255, 0.25);
}

/* 3. 已滑动部分 */
QSlider::sub-page:horizontal {
    height: 30px;
    border-radius: 5px;
    background-color: white;
}

QSlider::handle:horizontal {
    width: 20px;           
	background-color: white;
	border-radius: 5px;
    border: none;
}
</string>
     </property>
     <property name="minimum">
      <number>0</number>
     </property>
     <property name="maximum">
      <number>100</number>
     </property>
     <property name="sliderPosition">
      <number>65</number>
     </property>
     <property name="orientation">
      <enum>Qt::Horizontal</enum>
     </property>
    </widget>
