     <property name="styleSheet">
      <string notr="true">QLabel {
    /* 1. 圆角矩形核心：设置圆角半径（推荐4-8px，适配Label尺寸） */
    border-radius: 17px;
    
    /* 2. 边框设置：宽度 + 实线 + 颜色（可自定义） */
    border: 1px solid #ffffff; /* 1px浅灰色边框，替换颜色即可 */
    /* 常用边框颜色参考：
       #ffffff 白色 | #666666 中灰色 | #409eff 蓝色 | #f56c6c 红色
    */
    
    /* 3. 核心需求：背景完全透明 */
    background-color: transparent;
    
    /* 4. 字体（可选，延续你之前的灰色/白色需求） */
    color: #999999; /* 浅灰色字体，可改为white */
    font-size: 14px;
    
    /* 5. 内边距：避免文字紧贴边框，优化视觉 */
    padding: 4px 8px; /* 上下4px，左右8px，可根据Label大小调整 */
}</string>
     </property>
     <property name="text">
      <string/>
     </property>
    </widget>
