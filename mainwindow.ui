     <property name="styleSheet">
      <string notr="true">/* 基础圆形按钮样式（核心） */
QPushButton {

    /* 2. 核心：设置圆角为宽/高的一半，形成圆形 */
    border-radius: 25px; /* 必须=宽度/2，60/2=30 */
    
    /* 3. 配合你的风格：白色字体 + 透明背景（可自定义） */
    color: white;                  /* 字体白色 */
    border: none;                  /* 移除默认边框 */
    
    /* 4. 可选：文字居中、字体大小优化 */
    font-size: 14px;
    text-align: center;
	
	border-image: url(:/Icons/statusBar/Icons/account.jpg);

}
</string>
