      <property name="styleSheet">
       <string notr="true">/* ================= 默认状态 ================= */
QPushButton#playSortPushButton {
    border-image: url(:/Icons/musicPlayer/Icons/cyclicSort.png);
}

QPushButton#playSortPushButton:pressed {
    border-image: url(:/Icons/musicPlayer/Icons/cyclicSortHover.png);
}

/* ================= 列表循环 ================= */
QPushButton#playSortPushButton[playSort=&quot;1&quot;] {
    border-image: url(:/Icons/musicPlayer/Icons/cyclicSort.png);
}

QPushButton#playSortPushButton[playSort=&quot;1&quot;]:pressed {
    border-image: url(:/Icons/musicPlayer/Icons/cyclicSortHover.png);
}

/* ================= 单曲循环 ================= */
QPushButton#playSortPushButton[playSort=&quot;2&quot;] {
    border-image: url(:/Icons/musicPlayer/Icons/singleCyclicSort.png);
}

QPushButton#playSortPushButton[playSort=&quot;2&quot;]:pressed {
    border-image: url(:/Icons/musicPlayer/Icons/singleCyclicSortHover.png);
}

/* ================= 随机播放 ================= */
QPushButton#playSortPushButton[playSort=&quot;3&quot;] {
    border-image: url(:/Icons/musicPlayer/Icons/randomSort.png);
}

QPushButton#playSortPushButton[playSort=&quot;3&quot;]:pressed {
    border-image: url(:/Icons/musicPlayer/Icons/randomSortHover.png);
}</string>
