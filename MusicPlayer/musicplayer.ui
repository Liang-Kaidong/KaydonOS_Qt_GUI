      <property name="styleSheet">
       <string notr="true">QListWidget {
    color: white;
    border: none;  /* 去除边框 */
    border-radius: 10px;  /* 列表整体圆角效果 */
}

QListWidget::item {
    background-color: transparent;  /* 列表项的背景色 */
    margin: 4px;  /* 给项添加一点外边距 */
    padding-left: 10px;  /* 列表项的左侧内边距 */
    padding-right: 10px;  /* 右侧留出空间给勾选框 */
    padding-top: 10px;
    padding-bottom: 10px;
    height: 40px;  /* 设置列表项高度为40px */
}

QListWidget::item:selected {
    background-color: #4980F7;  /* 选中项的背景色 */
    color: white;
    border: none;  /* 去除边框 */
    border-radius: 10px;  /* 列表项选中时的圆角效果 */
}</string>
