      <property name="styleSheet">
       <string notr="true">/* 槽 */
QSlider::groove:horizontal {
    border: none;
    height: 12px;
    background: #8c8c8c;   /* 未播放浅灰 */
    border-radius: 4px;
}

/* 已播放 */
QSlider::sub-page:horizontal {
    background: white;
    border-radius: 4px;
}

/* 未播放 */
QSlider::add-page:horizontal {
    background: #8c8c8c;
    border-radius: 4px;
}

/* 滑块（默认状态-纯圆） */
QSlider::handle:horizontal {
    background: white;
    width: 20px;
    height: 20px;
    margin: -4px 0;      
    border-radius: 10px;
}
</string>
