              <property name="styleSheet">
               <string notr="true">QListWidget {
    background-color: rgb(50, 55, 67);
    color: white;
    border: none;  /* 去除边框 */
    border-radius: 10px;  /* 列表整体圆角效果 */
}

QListWidget::item {
    background-color: rgb(50, 55, 67);  /* 列表项的背景色 */
    margin: 4px;  /* 给项添加一点外边距 */
    padding-left: 10px;  /* 列表项的左侧内边距 */
    padding-right: 10px;  /* 右侧留出空间给勾选框 */
    padding-top: 10px;
    padding-bottom: 10px;
    font-size: 14px;  /* 设置字体大小 */
    text-align: left;  /* 文字左对齐 */
    vertical-align: middle;  /* 文字垂直居中 */
}

QListWidget::item:selected {
    background-color: rgb(255, 255, 255);  /* 选中项的背景色 */
    color: black;
    border: none;  /* 去除边框 */
    border-radius: 10px;  /* 列表整体圆角效果 */
}

</string>
