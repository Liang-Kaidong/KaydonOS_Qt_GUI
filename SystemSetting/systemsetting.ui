                  </property>
                  <property name="styleSheet">
                   <string notr="true">/* 基础圆形按钮样式（核心） */
QPushButton#voiceControlPushButton {
    
    /* 3. 配合你的风格：白色字体 + 透明背景（可自定义） */
    color: white;                  /* 字体白色 */
    border: none;                  /* 移除默认边框 */
    
    /* 4. 可选：文字居中、字体大小优化 */
    font-size: 14px;
    text-align: center;
	background-color: transparent;
	border-image: url(:/Icons/navigationBar/Icons/volUp.png);

}
</string>
                  </property>
                  <property name="text">
                   <string/>
                  </property>
                 </widget>
                </item>
                <item>
                 <widget class="QSlider" name="voiceControlSlider">
                  <property name="minimumSize">
                   <size>
                    <width>471</width>
                    <height>66</height>
                   </size>
                  </property>
                  <property name="maximumSize">
                   <size>
                    <width>471</width>
                    <height>81</height>
                   </size>
                  </property>
                  <property name="focusPolicy">
                   <enum>Qt::NoFocus</enum>
                  </property>
                  <property name="styleSheet">
                   <string notr="true">/* 1. 整个 Slider：可点击区域 */ 
QSlider { 
	min-height: 36px; 
	background: transparent; 
} 

/* 2. 凹槽 */ 
QSlider::groove:horizontal { 
	height: 30px; 
	border-radius: 5px; 
	background-color: rgba(255, 255, 255, 0.25); 
} 

/* 3. 已滑动部分 */ 
QSlider::sub-page:horizontal { 
	height: 30px; 
	border-radius: 5px; 
	background-color: white; 
} 

/* 4. 滑块：存在但不可见（关键） */
QSlider::handle:horizontal { 
	width: 20px; /* ⭐ 不能是 0 */ 
	background-color: white; 
	border-radius: 5px; 
	border: none; 
}</string>
                  </property>
                  <property name="minimum">
                   <number>0</number>
                  </property>
                  <property name="maximum">
